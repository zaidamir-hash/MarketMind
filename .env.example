# Reference only.
# Runtime config is loaded from:
# - backend/.env for the FastAPI backend
# - frontend/.env for the React frontend
# Use backend/.env.example and frontend/.env.example as the files you actually copy.
DATABASE_URL=postgresql+psycopg2://postgres:YOUR_PASSWORD@localhost:5432/marketmind
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=marketmind
POSTGRES_USER=postgres
POSTGRES_PASSWORD=YOUR_PASSWORD
JWT_SECRET_KEY=change-this-before-using-real-auth
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
FRONTEND_URL=http://127.0.0.1:5173
